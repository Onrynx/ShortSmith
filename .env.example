# ============================================================
#  Shortsmith .env — copy to .env only if you need to change a
#  default. A normal install needs NONE of this.
#
#  Shortsmith does not upload anything, does not call a hosted
#  AI service, and has no API keys to fill in. If you find a
#  setting here asking for a credential, something is wrong —
#  the previous version of this file listed keys for YouTube,
#  ElevenLabs, TikTok, Discord, Pexels and several hosted video
#  services, all of which have been removed from the code. They
#  were asking people to put live credentials on disk for paths
#  that no longer exist.
# ============================================================

# ---- The writer model (runs on this machine, via Ollama) ---------------
# Where Ollama is listening. Change only if you moved it.
OLLAMA_BASE_URL=http://localhost:11434

# Force one model instead of the one chosen for your hardware.
# Pick from the list in Settings; anything else will simply fail to load.
# OLLAMA_MODEL=qwen2.5:14b

# Pipeline engine: auto | langgraph | lite.
# auto = LangGraph if it is installed, otherwise the built-in runner.
# SHORTSMITH_ENGINE=auto


# ---- Media tools -------------------------------------------------------
# Shortsmith finds ffmpeg by testing each one on your PATH until one answers
# like the real thing. Set this to skip that and pin an exact binary.
# FFMPEG_BIN=C:\path\to\ffmpeg.exe

# faster-whisper model used for caption timing. Bigger is slower, not better:
# the words come from the script either way, whisper only supplies timings.
# WHISPER_MODEL=tiny

# Caption typeface. "Arial Black" exists on Windows and macOS; set your own
# on Linux if captions look wrong.
# CAPTION_FONT=Arial Black


# ---- Working files -----------------------------------------------------
# Keep each render's scratch directory instead of deleting it when the video
# finishes. Useful when something looks wrong; costs ~300 MB per video.
# SHORTSMITH_KEEP_WORK=1


# ---- Voice weights -----------------------------------------------------
# Kokoro's weights are downloaded once and checked against a pinned SHA-256.
# Only set these if you are serving the same files from your own mirror —
# and then set the checksum too, or the download will be accepted unverified.
# KOKORO_ONNX_URL=
# KOKORO_VOICES_URL=
# SHORTSMITH_KOKORO_SHA256=
