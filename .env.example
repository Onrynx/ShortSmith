# ============================================================
#  Shortsmith .env  — copy to .env and fill what you use.
#  MOCK MODE NEEDS NONE OF THESE. Add them to go live incrementally.
# ============================================================

# ---- Brain / LLM (all free, default local) -----------------------------
# 1) Odysseus (PewDiePie's self-hosted AI workspace) — PREFERRED when running.
#    Runs at :7000 with an OpenAI-compatible /v1 gateway. See scripts/setup_odysseus.sh
ODYSSEUS_URL=http://localhost:7000
ODYSSEUS_API_PATH=/v1
ODYSSEUS_MODEL=            # the model id Odysseus exposes (e.g. qwen2.5:14b); blank = auto-detect
ODYSSEUS_API_KEY=odysseus  # if your Odysseus requires a key
# ODYSSEUS_DISABLE=1       # set to skip Odysseus even if it's up

# 2) Ollama (used if Odysseus is down). qwen3:14b default; auto-downshift if RAM < 16GB.
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# 3) Gemini (used only if BOTH Odysseus and Ollama are unreachable). Free tier.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Force a pipeline engine (auto|langgraph|lite). auto = LangGraph if installed, else lite.
# SHORTSMITH_ENGINE=auto

# ---- Stock motion footage (free keys; unlimited backfill) --------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- DAY lane cloud video (free tier) ----------------------------------
# Veo via Google AI Studio uses GEMINI_API_KEY. Or Seedance.
CLOUD_VIDEO_PROVIDER=auto   # auto | veo | seedance
CLOUD_DAILY_CAP=5           # hero clips/day before falling back to stock + a 🟡 push
# VEO_MODEL=veo-3.0-generate-preview
SEEDANCE_URL=
SEEDANCE_API_KEY=

# ---- NIGHT lane local video (Wan2GP) -----------------------------------
WAN2GP_URL=http://localhost:7860
# WAN2GP_SUBMIT_PATH=/api/queue
# WAN2GP_STATUS_PATH=/api/status
# WAN2GP_RESULT_PATH=/api/result
# WAN2GP_MODEL=wan2.2-14B-i2v-GGUF-Q4
# WAN2GP_WIDTH=832
# WAN2GP_HEIGHT=480
# WAN2GP_ASYNC=false        # true = enqueue in the evening, re-run to collect in the morning

# ---- Voice engine (famous voices first, free fallback) -----------------
VOICE_ENGINE=auto            # auto | elevenlabs | tiktok | kokoro
# ElevenLabs = the famous AI-narrator voices. Free tier ~10k chars/mo, no card.
# Get a key: elevenlabs.io -> Profile -> API Key. Per-channel voice ids in config/.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# TikTok TTS (free, the classic short voices) — set a reachable endpoint if you
# have one (public ones are often rate-limited/down):
TIKTOK_TTS_URL=

# ---- Kokoro (free/local fallback) — auto-downloads ~340MB on first run -
# KOKORO_ONNX_URL=...
# KOKORO_VOICES_URL=...
# WHISPER_MODEL=tiny        # faster-whisper model for word-level captions (long-form)

# ---- Discord interface (THE control surface) ---------------------------
# Outbound events (🔴🟡🟢) post to a channel webhook — zero deps:
DISCORD_WEBHOOK_URL=
# Two-way control bot (pip install discord.py; enable Message Content intent):
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=0        # restrict commands to one channel id (0 = any)

# ---- Scheduler ---------------------------------------------------------

# ---- Publishing (optional; NEVER auto-public) --------------------------
PUBLISH=false               # true = upload PRIVATE to YouTube if creds present
YOUTUBE_CLIENT_SECRETS=     # path to OAuth client secrets json
YOUTUBE_TOKEN_JSON=         # path to authorized-user token json
