# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Secrets / local runtime state ---
# tokens, push subscriptions, checkpoints, cloud-cap, VAPID pem, run logs
.env
.storyforge_state/

# --- Large downloaded model weights (auto-download on first run) ---
models/*.onnx
models/*.bin

# --- Generated media (recreated by the pipeline at runtime) ---
output/

# --- Local media each user supplies themselves (GitHub caps files at 100MB) ---
# Gameplay backgrounds are personal downloads, never committed.
assets/backgrounds/*
!assets/backgrounds/README.txt

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
mockup/

# Generated launchers hold absolute paths to one machine — each user
# creates their own with: python scripts/make_shortcut.py
StoryForge.lnk
StoryForge.app/
StoryForge.desktop
